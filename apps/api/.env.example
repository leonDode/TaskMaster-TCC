# --- Prisma / Supabase Postgres ---
# Transaction pooler (Supavisor), porta 6543, usado em runtime.
# Ex: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5
DATABASE_URL=

# Session pooler (ou conexão direta, se seu projeto Supabase for IPv6-only-safe),
# porta 5432, usado apenas por `prisma migrate`.
# Ex: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=

# --- Supabase Auth (validação de JWT) ---
SUPABASE_URL=
# jwks (recomendado, projetos novos com JWT Signing Keys) | hs256 (legado)
SUPABASE_JWT_MODE=jwks
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
# Opcional — derivado de SUPABASE_URL (`${SUPABASE_URL}/auth/v1/.well-known/jwks.json`) se ausente
SUPABASE_JWKS_URL=
# Usado somente quando SUPABASE_JWT_MODE=hs256
SUPABASE_JWT_SECRET=

# --- Supabase Storage (upload de avatar) ---
# Service role key — bypassa RLS, usada só no backend pra gravar no bucket
# `avatars`. Nunca expor no client/apps/web. Dashboard do Supabase:
# Project Settings > API > service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# --- HTTP / CORS ---
CORS_ORIGINS=
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
